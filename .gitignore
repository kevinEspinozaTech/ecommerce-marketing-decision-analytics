# ==========================================================
# Credentials, secrets, and API keys — NEVER commit these
# ==========================================================
.env
.env.*
!.env.example
*credentials*
*secret*
*secrets*
*.key
*.pem
*.p12
*.pfx
*token*
*api_key*
*apikey*

# ==========================================================
# n8n local configuration, database, and runtime data
# ==========================================================
.n8n/
n8n_data/
*.sqlite
*.sqlite3
config.json
.n8n-webhooks/

# ==========================================================
# Logs
# ==========================================================
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==========================================================
# Temporary / cache files
# ==========================================================
*.tmp
*.temp
*.bak
*.swp
*~
.cache/
tmp/
temp/

# ==========================================================
# Python
# ==========================================================
__pycache__/
*.py[cod]
*.pyo

# ==========================================================
# Virtual environments
# ==========================================================
.venv/
venv/
env/

# ==========================================================
# Jupyter
# ==========================================================
.ipynb_checkpoints/

# ==========================================================
# SQL Server
# (*.bak is already covered under "Temporary / cache files")
# ==========================================================
*.mdf
*.ldf

# ==========================================================
# Power BI — local lock/temp files only.
# .pbix itself is intentionally NOT ignored: which Power BI
# artifacts belong in the portfolio is a conscious decision
# to make later, not a default.
# ==========================================================
~$*.pbix

# Power BI Project (.pbip) local files: the data cache holds the
# imported (unversioned) snapshot rows; local settings are per user.
**/.pbi/cache.abf
**/.pbi/localSettings.json

# ==========================================================
# OS / editor junk
# ==========================================================
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# ==========================================================
# Dependencies (if any Node tooling is added later)
# ==========================================================
node_modules/

# ==========================================================
# Data snapshots — raw CSV extracts of TheLook are NOT committed:
# redistribution licensing is unverified (Stage 1) and files
# are large. Regenerate with scripts/export_snapshot.py.
# Snapshot manifests (data/raw/manifest_*.json) ARE committed
# as evidence: T, row counts, SHA-256, reference KPIs.
# Category ranking references are also committed: they are
# per-category aggregates with no personal data.
# Product ranking references and sensitivity files (Stage 4)
# are committed for the same reason: per-product aggregates,
# no personal data.
# Garment-type review, type ranking references and type examples
# (Stage 4) are committed for the same reason: per-product or
# per-type aggregates, no personal data.
# ==========================================================
data/raw/*.csv
!data/raw/category_ranking_reference_*.csv
!data/raw/product_ranking_reference_*.csv
!data/raw/product_ranking_sensitivity_*.csv
!data/raw/product_type_review_*.csv
!data/raw/type_ranking_reference_*.csv
!data/raw/type_ranking_examples_*.csv
Claude outputs/